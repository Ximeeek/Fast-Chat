{
  "name": "fastchat-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:host": "node scripts/dev.mjs --host",
    "build": "node scripts/build-pages.mjs",
    "build:landing": "npm --prefix apps/landing run build",
    "build:room": "npm --prefix apps/room run build",
    "build:pages": "node scripts/build-pages.mjs",
    "test:room": "npm --prefix apps/room test",
    "test:deploy": "node --test tests/deployment.test.mjs",
    "test": "npm run test:room && npm run test:deploy"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.27.7",
    "@img/sharp-libvips-linux-x64": "^1.2.4",
    "@img/sharp-linux-x64": "^0.34.5",
    "@rolldown/binding-linux-x64-gnu": "^1.2.7",
    "@rolldown/binding-linux-x64-musl": "^1.2.7",
    "@rollup/rollup-linux-x64-gnu": "^4.63.1",
    "@rollup/rollup-linux-x64-musl": "^4.63.1",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "lightningcss-linux-x64-musl": "^1.33.0"
  }
}
