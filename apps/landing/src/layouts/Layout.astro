---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'FastChat Room - Ephemeral P2P Chat & Quick File Transfer' } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-[#0a0a0a] text-zinc-100">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-[#0a0a0a] text-zinc-100 flex flex-col antialiased selection:bg-[#ccff00] selection:text-black">
		<slot />
	</body>
</html>
