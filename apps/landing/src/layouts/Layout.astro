---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';

interface Props {
	title?: string;
	description?: string;
	canonicalUrl?: string;
}

const { title, description, canonicalUrl } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-[#050608] text-zinc-100">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Orbitron:wght@500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
		<SeoHead title={title} description={description} canonicalUrl={canonicalUrl} />
	</head>
	<body class="min-h-screen bg-[#050608] text-zinc-100 flex flex-col antialiased selection:bg-[#0066ff] selection:text-white font-sans">
		<slot />
	</body>
</html>
