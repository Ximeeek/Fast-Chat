---
// Header component for FastChat Room landing page
---

<header class="w-full border-b border-[#161c28] bg-[#050608]/90 sticky top-0 z-50 backdrop-blur-md">
	<!-- Beta Notice Top Banner -->
	<div class="w-full bg-amber-500/10 border-b border-amber-500/25 px-4 py-1.5 backdrop-blur-md">
		<div class="max-w-6xl mx-auto flex items-center justify-center gap-2 text-center text-xs font-mono text-amber-300">
			<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-amber-500/20 border border-amber-500/40 text-[10px] font-bold uppercase tracking-wider text-amber-300">
				<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
				BETA VERSION
			</span>
			<span class="text-zinc-300 text-[11px] sm:text-xs">
				FastChat is in active beta. You may experience bugs or unexpected behavior.
			</span>
		</div>
	</div>

	<div class="max-w-6xl mx-auto px-4 sm:px-6 h-18 flex items-center justify-between">
		<div class="flex items-center gap-2.5 sm:gap-3">
			<a href="/" class="flex items-center gap-3 group">
				<div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-600 to-cyan-400 p-0.5 shadow-[0_0_15px_rgba(0,102,255,0.4)] flex items-center justify-center">
					<div class="w-full h-full bg-[#050608] rounded-[6px] flex items-center justify-center">
						<svg class="w-4 h-4 text-cyan-400 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
							<circle cx="12" cy="11" r="2" fill="currentColor"/>
						</svg>
					</div>
				</div>
				<span class="font-['Orbitron',sans-serif] font-black tracking-widest text-base sm:text-lg text-white group-hover:text-cyan-300 transition-colors uppercase">
					FASTCHAT <span class="text-blue-500">//</span> <span class="text-zinc-400 font-semibold">ROOM</span>
				</span>
			</a>

			<div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-amber-500/15 border border-amber-500/35 text-amber-400 text-[10px] font-mono font-bold tracking-wider uppercase shadow-[0_0_10px_rgba(245,158,11,0.2)]" title="Beta software: actively under development and may contain bugs">
				<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
				<span>BETA</span>
			</div>
		</div>

		<div class="flex items-center gap-4">
			<div class="hidden sm:flex items-center gap-2 text-xs text-blue-400 font-medium px-3.5 py-1.5 rounded-full bg-blue-950/40 border border-blue-500/25 shadow-[0_0_15px_rgba(0,102,255,0.1)]">
				<span class="inline-block w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_8px_#00e5ff] animate-pulse"></span>
				<span class="tracking-wide text-[11px] uppercase font-semibold">MESH P2P ONLINE</span>
			</div>

			<a
				href="/create"
				class="inline-flex items-center justify-center gap-2.5 px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-white text-black hover:bg-zinc-200 active:scale-[0.98] transition-all shadow-[0_0_20px_rgba(255,255,255,0.2)] tracking-wider uppercase font-['Inter',sans-serif] group"
			>
				<svg class="w-3.5 h-3.5 fill-black group-hover:scale-110 transition-transform" viewBox="0 0 16 16">
					<circle cx="2" cy="2" r="1.5"/>
					<circle cx="8" cy="2" r="1.5"/>
					<circle cx="14" cy="2" r="1.5"/>
					<circle cx="2" cy="8" r="1.5"/>
					<circle cx="8" cy="8" r="1.5"/>
					<circle cx="14" cy="8" r="1.5"/>
					<circle cx="2" cy="14" r="1.5"/>
					<circle cx="8" cy="14" r="1.5"/>
					<circle cx="14" cy="14" r="1.5"/>
				</svg>
				<span>CREATE ROOM</span>
			</a>
		</div>
	</div>
</header>

