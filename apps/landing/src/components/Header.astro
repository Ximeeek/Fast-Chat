---
// Header component for FastChat Room landing page
---

<header class="w-full border-b border-[#262626] bg-[#0a0a0a]/95 sticky top-0 z-50 backdrop-blur-sm">
	<div class="w-full h-1 hazard-stripes-accent"></div>
	<div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
		<a href="/" class="flex items-center gap-3 text-zinc-100 group">
			<div class="w-3 h-3 bg-[#ccff00]"></div>
			<span class="font-bold tracking-wider text-sm sm:text-base group-hover:text-[#ccff00] transition-colors">
				FASTCHAT <span class="text-zinc-600">//</span> ROOM
			</span>
		</a>

		<div class="flex items-center gap-4">
			<div class="hidden sm:flex items-center gap-2 text-xs text-zinc-500 font-mono border border-[#262626] px-2.5 py-1 bg-[#121212]">
				<span class="inline-block w-1.5 h-1.5 bg-[#ccff00] animate-pulse"></span>
				<span>MESH P2P ONLINE</span>
			</div>

			<a
				href="/create"
				class="inline-flex items-center justify-center px-4 py-2 text-xs sm:text-sm font-bold bg-[#ccff00] text-black hover:bg-[#b8e600] active:scale-[0.98] transition-all border border-[#ccff00] tracking-wide"
			>
				CREATE ROOM
			</a>
		</div>
	</div>
</header>
