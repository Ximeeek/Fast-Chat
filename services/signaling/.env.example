# Cloudflare TURN API Credentials (Optional - public STUN fallback operates when omitted)
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_KEY_ID=

# Signaling Server Network Binding (Optional - defaults to 0.0.0.0:3000)
PORT=3000
HOST=0.0.0.0

# Optional Cost Governor & Room Limits
FASTCHAT_TURN_MAX_MONTHLY_BYTES=966367641600
FASTCHAT_MAX_PARTICIPANTS_PER_ROOM=4
